# Grid AI — copy to .env and fill in. The SDK reads these via app.build_llm().

# --- Option A: cloud model ---
LLM_MODEL=openai/your-model
LLM_API_KEY=sk-...

# --- Option B: local model (Ollama / vLLM) — leave API_KEY blank ---
# LLM_MODEL=ollama/qwen2.5-coder:32b
# LLM_BASE_URL=http://localhost:11434
